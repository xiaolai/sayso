[
 {
  "id": "pcm-encode",
  "component": "pcm16",
  "op": "encode",
  "input": [
   0.0,
   1.0,
   -1.0,
   0.5,
   -0.5,
   2.0,
   -2.0,
   "NaN",
   "Infinity",
   "-Infinity",
   3e-05,
   -3e-05,
   0.999999
  ],
  "expectSamples": [
   0,
   32767,
   -32767,
   16383,
   -16383,
   32767,
   -32767,
   0,
   0,
   0,
   0,
   0,
   32766
  ],
  "expectHex": "0000ff7f0180ff3f01c0ff7f018000000000000000000000fe7f",
  "note": "NaN and infinities are strings because JSON has no such numbers; each becomes 0."
 },
 {
  "id": "pcm-decode",
  "component": "pcm16",
  "op": "decode",
  "hex": "00800100ff7f0000",
  "expectSamples": [
   -32768,
   1,
   32767,
   0
  ],
  "note": "A float is the sample divided by 32768."
 },
 {
  "id": "pcm-decode-slice",
  "component": "pcm16",
  "op": "decode",
  "hex": "aa0100ff7f",
  "sliceFrom": 1,
  "expectSamples": [
   1,
   32767
  ],
  "note": "The buffer is a slice starting at byte 1 of a larger buffer; it decodes like a copy."
 },
 {
  "id": "pcm-decode-odd",
  "component": "pcm16",
  "op": "decode",
  "hex": "010002",
  "expectSamples": [
   1
  ],
  "note": "A trailing odd byte is ignored."
 },
 {
  "id": "pcm-decode-empty",
  "component": "pcm16",
  "op": "decode",
  "hex": "",
  "expectSamples": []
 },
 {
  "id": "pcm-wav-24k",
  "component": "pcm16",
  "op": "wav",
  "rate": 24000,
  "pcmHex": "0100ff7f",
  "expectHex": "524946462800000057415645666d74201000000001000100c05d000080bb00000200100064617461040000000100ff7f"
 },
 {
  "id": "pcm-wav-16k",
  "component": "pcm16",
  "op": "wav",
  "rate": 16000,
  "pcmHex": "0100",
  "expectHex": "524946462600000057415645666d74201000000001000100803e0000007d00000200100064617461020000000100"
 },
 {
  "id": "pcm-wav-rate-max",
  "component": "pcm16",
  "op": "wav",
  "rate": 2147483647,
  "pcmHex": "0100",
  "expectHex": "524946462600000057415645666d74201000000001000100ffffff7ffeffffff0200100064617461020000000100",
  "note": "The highest rate whose byte rate, rate × 2, fits 32 bits."
 },
 {
  "id": "pcm-wav-rate-over",
  "component": "pcm16",
  "op": "wav",
  "rate": 2147483648,
  "pcmHex": "0100",
  "expectError": true,
  "note": "Its byte rate would wrap to zero in the header; an error, never a wrapped header."
 },
 {
  "id": "pcm-wav-rate-zero",
  "component": "pcm16",
  "op": "wav",
  "rate": 0,
  "pcmHex": "0100",
  "expectError": true,
  "note": "A rate below 1 is no sample rate."
 },
 {
  "id": "pcm-valid-wav",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100c05d000080bb00000200100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": true
 },
 {
  "id": "pcm-valid-wav-rate",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100803e0000007d00000200100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false
 },
 {
  "id": "pcm-valid-wav-riff-size",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946466300000057415645666d74201000000001000100c05d000080bb00000200100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false
 },
 {
  "id": "pcm-valid-wav-data-size",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100c05d000080bb00000200100064617461020000000100ff7f",
  "capBytes": 1000,
  "expect": false
 },
 {
  "id": "pcm-valid-wav-stereo",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000200c05d000080bb00000200100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false
 },
 {
  "id": "pcm-valid-wav-odd",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462700000057415645666d74201000000001000100c05d000080bb0000020010006461746103000000010203",
  "capBytes": 1000,
  "expect": false
 },
 {
  "id": "pcm-valid-wav-empty",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462400000057415645666d74201000000001000100c05d000080bb0000020010006461746100000000",
  "capBytes": 1000,
  "expect": false
 },
 {
  "id": "pcm-valid-wav-over-cap",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100c05d000080bb00000200100064617461040000000100ff7f",
  "capBytes": 2,
  "expect": false
 },
 {
  "id": "pcm-valid-wav-at-cap",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100c05d000080bb00000200100064617461040000000100ff7f",
  "capBytes": 4,
  "expect": true
 },
 {
  "id": "pcm-valid-wav-not-riff",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946582800000057415645666d74201000000001000100c05d000080bb00000200100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false
 },
 {
  "id": "pcm-valid-wav-format-float",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000003000100c05d000080bb00000200100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false,
  "note": "Format 3 (IEEE float) instead of 1 (PCM), every other field canonical."
 },
 {
  "id": "pcm-valid-wav-bits-8",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100c05d0000c05d00000100080064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false,
  "note": "A consistent 8-bit mono header at 24 kHz: only 16-bit PCM is valid."
 },
 {
  "id": "pcm-valid-wav-block-align",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100c05d000080bb00000400100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false,
  "note": "Block align 4 where 16-bit mono has 2."
 },
 {
  "id": "pcm-valid-wav-byte-rate",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100c05d0000c05d00000200100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false,
  "note": "A byte rate equal to the sample rate, where 16-bit mono has twice it."
 },
 {
  "id": "pcm-valid-wav-fmt-size",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462a00000057415645666d74201200000001000100c05d000080bb000002001000000064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false,
  "note": "A well-formed 18-byte fmt chunk (cbSize 0): only the 16-byte canonical chunk is valid."
 },
 {
  "id": "pcm-valid-wav-list-chunk",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946463400000057415645666d74201000000001000100c05d000080bb0000020010004c49535404000000494e464f64617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false,
  "note": "A well-formed LIST chunk between fmt and data: no other chunk is valid."
 },
 {
  "id": "pcm-valid-wav-wave-id",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415658666d74201000000001000100c05d000080bb00000200100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false,
  "note": "WAVX instead of WAVE."
 },
 {
  "id": "pcm-valid-wav-fmt-id",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d745f1000000001000100c05d000080bb00000200100064617461040000000100ff7f",
  "capBytes": 1000,
  "expect": false,
  "note": "fmt_ instead of fmt."
 },
 {
  "id": "pcm-valid-wav-data-id",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100c05d000080bb00000200100044415441040000000100ff7f",
  "capBytes": 1000,
  "expect": false,
  "note": "DATA instead of data."
 },
 {
  "id": "pcm-valid-wav-short",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462800000057415645666d74201000000001000100c05d000080bb00000200100064617461040000",
  "capBytes": 1000,
  "expect": false,
  "note": "43 bytes, one short of the header."
 },
 {
  "id": "pcm-valid-wav-nothing",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "",
  "capBytes": 1000,
  "expect": false,
  "note": "No bytes at all."
 },
 {
  "id": "pcm-valid-wav-one-byte",
  "component": "pcm16",
  "op": "validWAV",
  "hex": "524946462500000057415645666d74201000000001000100c05d000080bb000002001000646174610100000001",
  "capBytes": 1000,
  "expect": false,
  "note": "One data byte: odd, and less than one sample."
 },
 {
  "id": "pcm-plausible",
  "component": "pcm16",
  "op": "plausible",
  "pcm": {
   "samples": 24000,
   "value": 328
  },
  "script": "abcdefghijklmnopqrstuvwxy",
  "expect": true,
  "note": "25 letters need 1 s: 24,000 samples."
 },
 {
  "id": "pcm-plausible-short",
  "component": "pcm16",
  "op": "plausible",
  "pcm": {
   "samples": 23999,
   "value": 328
  },
  "script": "abcdefghijklmnopqrstuvwxy",
  "expect": false
 },
 {
  "id": "pcm-plausible-quiet",
  "component": "pcm16",
  "op": "plausible",
  "pcm": {
   "samples": 24000,
   "value": 327
  },
  "script": "abcdefghijklmnopqrstuvwxy",
  "expect": false,
  "note": "327 is below -40 dBFS."
 },
 {
  "id": "pcm-plausible-negative",
  "component": "pcm16",
  "op": "plausible",
  "pcm": {
   "samples": 24000,
   "value": -328
  },
  "script": "abcdefghijklmnopqrstuvwxy",
  "expect": true,
  "note": "Magnitude, not sign."
 },
 {
  "id": "pcm-plausible-punctuation",
  "component": "pcm16",
  "op": "plausible",
  "pcm": {
   "samples": 9600,
   "value": 1000
  },
  "script": "Hello, world!",
  "expect": true,
  "note": "Ten letters need 0.4 s; punctuation and spaces are not letters."
 },
 {
  "id": "pcm-plausible-han",
  "component": "pcm16",
  "op": "plausible",
  "pcm": {
   "samples": 2880,
   "value": 1000
  },
  "script": "你好世界",
  "expect": false,
  "note": "Han characters are letters: four need 0.16 s, 3,840 samples; 2,880 is too few."
 },
 {
  "id": "pcm-plausible-empty-script",
  "component": "pcm16",
  "op": "plausible",
  "pcm": {
   "samples": 1,
   "value": 1000
  },
  "script": "",
  "expect": true,
  "note": "No letters need no time."
 }
]