{"id": "app-client-events-in-order", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"method": "turn/started", "params": {"turn": {"id": "t1"}}}, {"method": "item/completed", "params": {"item": {"type": "agentMessage", "text": "hola"}}}, {"id": "srv-1", "method": "execCommandApproval", "params": {"command": ["ls"]}}], "result": {"turn": {"id": "t1"}}, "notifyAfter": [{"method": "turn/completed", "params": {"turn": {"id": "t1", "status": "completed"}}}]}], "account/usage/read": [{"notify": [{"method": "thread/tokenUsage/updated", "params": {"tokenUsage": {"total": {"totalTokens": 7}}}}], "result": {}}]}}, "client": {"handler": "record", "calls": [{"method": "turn/start", "params": {"q": 1}}, {"method": "account/usage/read"}]}}, "expect": {"calls": ["ok", "ok"], "events": [{"method": "turn/started", "params": {"turn": {"id": "t1"}}}, {"method": "item/completed", "params": {"item": {"type": "agentMessage", "text": "hola"}}}, {"method": "execCommandApproval", "params": {"command": ["ls"]}, "serverRequest": true}, {"method": "turn/completed", "params": {"turn": {"id": "t1", "status": "completed"}}}, {"method": "thread/tokenUsage/updated", "params": {"tokenUsage": {"total": {"totalTokens": 7}}}}], "serverRequestAnswered": "error", "childrenExited": true}, "note": "Notifications and a server request reach the handler in the order the child wrote them, before, between and after replies; the server request is still refused."}
{"id": "app-client-many-events-in-order", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"method": "n", "params": {"n": "$i"}, "repeat": 500}], "result": {}}]}}, "client": {"handler": "record", "calls": [{"method": "turn/start"}]}}, "expect": {"calls": ["ok"], "eventCount": 500, "eventSequence": "n"}, "note": "Five hundred notifications arrive one at a time, in order."}
{"id": "app-client-no-handler", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"method": "n", "params": {"n": "$i"}, "repeat": 50}, {"id": "srv-1", "method": "approve"}], "result": {}}]}}, "client": {"calls": [{"method": "turn/start"}, {"method": "turn/start"}]}}, "expect": {"calls": ["ok", "ok"], "serverRequestAnswered": "error"}, "note": "Without a handler notifications are ignored, as before, and the client keeps working."}
{"id": "app-client-handler-overflow", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 300000, "server": {"methods": {"turn/start": [{"notify": [{"method": "big", "padBytes": 1000000, "repeat": 12}], "result": {}}]}}, "client": {"handler": "block", "calls": [{"method": "turn/start"}, {"method": "turn/start"}]}}, "expect": {"calls": ["error", "error"], "childrenExited": true, "callError": "faster than the handler"}, "note": "A handler that does not keep up: events queued beyond 8 MiB fail the client, and its call, with a codex-error; the call fails with the overflow, and so does every later call."}
{"id": "app-client-event-shapes", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"method": "bare"}, {"method": "null-params", "params": null}, {"method": 5, "params": {}}, {"params": {"orphan": true}}, {"method": "list", "params": [1, "two", null]}], "result": {}}]}}, "client": {"handler": "record", "calls": [{"method": "turn/start"}]}}, "expect": {"calls": ["ok"], "events": [{"method": "bare", "noParams": true}, {"method": "null-params", "params": null}, {"method": "list", "params": [1, "two", null]}]}, "note": "A notification without params has none; null params are null; one whose method is absent or not a string is ignored, as without a handler."}
{"id": "app-client-working-directory", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"probe": [{"notify": [{"method": "cwd", "params": {"cwd": "$cwd"}}], "result": {}}]}}, "client": {"handler": "record", "dir": "work", "calls": [{"method": "probe"}]}}, "expect": {"calls": ["ok"], "events": [{"method": "cwd", "params": {"cwd": "$work"}}]}, "note": "The child starts in the configured working directory."}
{"id": "app-client-working-directory-default", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"probe": [{"notify": [{"method": "cwd", "params": {"cwd": "$cwd"}}], "result": {}}]}}, "client": {"handler": "record", "calls": [{"method": "probe"}]}}, "expect": {"calls": ["ok"], "events": [{"method": "cwd", "params": {"cwd": "$callerCwd"}}]}, "note": "Without a working directory the child keeps the caller's."}
{"id": "app-client-working-directory-relative", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {}, "client": {"handler": "record", "dir": "relative", "calls": []}}, "expect": {"startFails": true, "spawns": 0}, "note": "A working directory that is a relative path is refused before anything starts."}
{"id": "app-client-working-directory-missing", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {}, "client": {"handler": "record", "dir": "missing", "calls": []}}, "expect": {"startFails": true, "spawns": 0}, "note": "A working directory that is a folder that does not exist is refused before anything starts."}
{"id": "app-client-working-directory-file", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {}, "client": {"handler": "record", "dir": "file", "calls": []}}, "expect": {"startFails": true, "spawns": 0}, "note": "A working directory that is a file, not a folder is refused before anything starts."}
{"id": "app-client-experimental-api", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"probe": [{"result": {}}]}}, "client": {"experimentalAPI": true, "calls": [{"method": "probe"}]}}, "expect": {"calls": ["ok"], "requests": [{"method": "initialize", "params": {"clientInfo": {"name": "sayso", "version": "0"}, "capabilities": {"experimentalApi": true}}}, {"method": "initialized", "notification": true}, {"method": "probe", "params": {}}]}, "note": "The experimental API is asked for in initialize only when configured."}
{"id": "app-client-default-capabilities", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {}, "client": {"calls": []}}, "expect": {"requests": [{"method": "initialize", "params": {"clientInfo": {"name": "sayso", "version": "0"}, "capabilities": {}}}, {"method": "initialized", "notification": true}]}, "note": "By default initialize asks for no capability."}
{"id": "app-client-outbound-order", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"m1": [{"notify": [{"id": "srv-1", "method": "approve"}], "result": {}}], "m2": [{"notify": [{"id": "srv-2", "method": "approve"}, {"id": "srv-3", "method": "approve"}], "result": {}}], "m3": [{"result": {}}]}}, "client": {"calls": [{"method": "m1"}, {"method": "m2"}, {"method": "m3"}]}}, "expect": {"calls": ["ok", "ok", "ok"], "outbound": ["initialize", "initialized", "m1", "refusal:srv-1", "m2", "refusal:srv-2", "refusal:srv-3", "m3"], "serverRequestAnswered": "error"}, "note": "Requests and answers to server requests share one ordered writer: each request is written after every answer queued before it (the server requests that arrived before the previous reply) and ahead of any queued after."}
{"id": "app-client-refusal-written-while-a-call-waits", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"m1": [{"notify": [{"id": "srv-1", "method": "approve"}], "awaitLines": 1, "result": {}}], "m2": [{"result": {}}]}}, "client": {"calls": [{"method": "m1"}, {"method": "m2"}]}}, "expect": {"calls": ["ok", "ok"], "outbound": ["initialize", "initialized", "m1", "refusal:srv-1", "m2"], "serverRequestAnswered": "error"}, "note": "The fake reads the answer to srv-1 before it replies to m1: an answer admitted after a request is written while that request's call still waits (the writer is not the caller), and ahead of the request queued after it."}
{"id": "app-client-params-exact-bytes", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"rawLine": "{\"method\":\"exotic\",\"params\":{ \"n\" : 1e-400 , \"d\": 3.14159265358979323846264338327950288, \"s\": \"a\\u00e9\" }}"}, {"rawLine": "{\"method\":\"spaced\",\"params\":   [ 1 ,\t2 ,  {\"k\" :\"v\"} ]  }"}], "result": {}}]}}, "client": {"handler": "record", "calls": [{"method": "turn/start"}]}}, "expect": {"calls": ["ok"], "events": [{"method": "exotic", "paramsRaw": "{ \"n\" : 1e-400 , \"d\": 3.14159265358979323846264338327950288, \"s\": \"a\\u00e9\" }"}, {"method": "spaced", "paramsRaw": "[ 1 ,\t2 ,  {\"k\" :\"v\"} ]"}]}, "note": "The params reach the handler byte for byte as the child wrote them: whitespace, escapes, an underflowing exponent and digits beyond a double all survive."}
{"id": "app-client-empty-events-at-the-count-bound", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 60000, "server": {"methods": {"turn/start": [{"notify": [{"method": "", "repeat": 65536}], "result": {}}]}}, "client": {"handler": "block", "calls": [{"method": "turn/start"}]}}, "expect": {"calls": ["ok"]}, "note": "65,536 events are held for a handler that does not return, the one it is handling included: at the count bound, the client still works."}
{"id": "app-client-empty-events-past-the-count-bound", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 60000, "server": {"methods": {"turn/start": [{"notify": [{"method": "", "repeat": 65537}], "result": {}}]}}, "client": {"handler": "block", "calls": [{"method": "turn/start"}, {"method": "turn/start"}]}}, "expect": {"calls": ["error", "error"], "callError": "faster than the handler", "childrenExited": true}, "note": "One event past the count bound fails the client even though every event is empty (each is charged 64 bytes on top of its method and params): the call fails with the overflow, and so does every later call."}
{"id": "app-client-events-at-the-byte-bound", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 60000, "server": {"methods": {"turn/start": [{"notify": [{"method": "big", "padBytes": 1048498, "repeat": 8}], "result": {}}]}}, "client": {"handler": "block", "calls": [{"method": "turn/start"}]}}, "expect": {"calls": ["ok"]}, "note": "Eight events of exactly 1 MiB each as charged (64 + the 3-byte method + params {\"pad\": \"x...\"} of 11 + 1,048,498 bytes) fill the 8 MiB bound exactly: the client still works."}
{"id": "app-client-events-past-the-byte-bound", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 60000, "server": {"methods": {"turn/start": [{"notify": [{"method": "big", "padBytes": 1048499, "repeat": 8}], "result": {}}]}}, "client": {"handler": "block", "calls": [{"method": "turn/start"}]}}, "expect": {"calls": ["error"], "callError": "faster than the handler"}, "note": "One byte more per event passes the 8 MiB bound on the eighth: the client fails with the overflow."}
{"id": "app-client-plan-type", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"account/read": [{"result": {"account": {"type": "chatgpt", "email": "canary-plan@example.invalid", "planType": "plus"}}}, {"result": {"account": {"planType": "pro"}}}]}}, "client": {"calls": [{"method": "account/read", "typed": true}, {"method": "account/read", "typed": true}]}}, "expect": {"calls": ["ok", "ok"], "typedResults": ["plus", "pro"], "notInDescription": ["canary-plan"]}, "note": "The plan type, and only it, from account/read: the email beside it is never read."}
{"id": "app-client-plan-type-absent", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"account/read": [{"result": {}}, {"result": {"account": null}}, {"result": {"account": {}}}, {"result": {"account": {"planType": null}}}]}}, "client": {"calls": [{"method": "account/read", "typed": true}, {"method": "account/read", "typed": true}, {"method": "account/read", "typed": true}, {"method": "account/read", "typed": true}]}}, "expect": {"calls": ["ok", "ok", "ok", "ok"], "typedResults": ["", "", "", ""]}, "note": "No account, a null account, no planType and a null planType all read as no plan."}
{"id": "app-client-plan-type-wrong-type", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"account/read": [{"result": {"account": []}}, {"result": {"account": {"planType": 123}}}, {"result": {"account": "chatgpt"}}, {"result": []}]}}, "client": {"calls": [{"method": "account/read", "typed": true}, {"method": "account/read", "typed": true}, {"method": "account/read", "typed": true}, {"method": "account/read", "typed": true}]}}, "expect": {"calls": ["error", "error", "error", "error"], "typedResults": [null, null, null, null], "callError": "unexpected account/read result"}, "note": "A present account or planType of the wrong type, or a result that is no object, is an error."}
