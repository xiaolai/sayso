{"id": "app-client-events-in-order", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"method": "turn/started", "params": {"turn": {"id": "t1"}}}, {"method": "item/completed", "params": {"item": {"type": "agentMessage", "text": "hola"}}}, {"id": "srv-1", "method": "execCommandApproval", "params": {"command": ["ls"]}}], "result": {"turn": {"id": "t1"}}, "notifyAfter": [{"method": "turn/completed", "params": {"turn": {"id": "t1", "status": "completed"}}}]}], "account/usage/read": [{"notify": [{"method": "thread/tokenUsage/updated", "params": {"tokenUsage": {"total": {"totalTokens": 7}}}}], "result": {}}]}}, "client": {"handler": "record", "calls": [{"method": "turn/start", "params": {"q": 1}}, {"method": "account/usage/read"}]}}, "expect": {"calls": ["ok", "ok"], "events": [{"method": "turn/started", "params": {"turn": {"id": "t1"}}}, {"method": "item/completed", "params": {"item": {"type": "agentMessage", "text": "hola"}}}, {"method": "execCommandApproval", "params": {"command": ["ls"]}, "serverRequest": true}, {"method": "turn/completed", "params": {"turn": {"id": "t1", "status": "completed"}}}, {"method": "thread/tokenUsage/updated", "params": {"tokenUsage": {"total": {"totalTokens": 7}}}}], "serverRequestAnswered": "error", "childrenExited": true}, "note": "Notifications and a server request reach the handler in the order the child wrote them, before, between and after replies; the server request is still refused."}
{"id": "app-client-many-events-in-order", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"method": "n", "params": {"n": "$i"}, "repeat": 500}], "result": {}}]}}, "client": {"handler": "record", "calls": [{"method": "turn/start"}]}}, "expect": {"calls": ["ok"], "eventCount": 500, "eventSequence": "n"}, "note": "Five hundred notifications arrive one at a time, in order."}
{"id": "app-client-no-handler", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"method": "n", "params": {"n": "$i"}, "repeat": 50}, {"id": "srv-1", "method": "approve"}], "result": {}}]}}, "client": {"calls": [{"method": "turn/start"}, {"method": "turn/start"}]}}, "expect": {"calls": ["ok", "ok"], "serverRequestAnswered": "error"}, "note": "Without a handler notifications are ignored, as before, and the client keeps working."}
{"id": "app-client-handler-overflow", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"method": "big", "padBytes": 1000000, "repeat": 12}], "result": {}}]}}, "client": {"handler": "block", "calls": [{"method": "turn/start"}]}}, "expect": {"calls": ["error"], "childrenExited": true}, "note": "A handler that does not keep up: events queued beyond 8 MiB fail the client, and its call, with a codex-error."}
{"id": "app-client-event-shapes", "component": "credentials", "setup": {"codex": "fake", "codexHome": "default", "timeoutMs": 5000, "server": {"methods": {"turn/start": [{"notify": [{"method": "bare"}, {"method": "null-params", "params": null}, {"method": 5, "params": {}}, {"params": {"orphan": true}}, {"method": "list", "params": [1, "two", null]}], "result": {}}]}}, "client": {"handler": "record", "calls": [{"method": "turn/start"}]}}, "expect": {"calls": ["ok"], "events": [{"method": "bare", "noParams": true}, {"method": "null-params", "params": null}, {"method": "list", "params": [1, "two", null]}]}, "note": "A notification without params has none; null params are null; one whose method is absent or not a string is ignored, as without a handler."}
