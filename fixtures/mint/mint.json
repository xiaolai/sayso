   "session": {
    "type": "realtime",
    "model": "gpt-realtime",
    "output_modalities": [
     "audio"
    ]
   },
   "lifetimeSeconds": 600,
   "token": {
    "$jwt": {
     "exp": 1800003600
    }
   },
   "refreshTo": {
