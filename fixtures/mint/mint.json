    "method": "POST",
    "path": "/v1/realtime/client_secrets",
    "authorization": "Bearer $token",
    "contentType": "application/json",
    "body": {
     "session": {
      "type": "realtime",
      "model": "gpt-realtime",
      "output_modalities": [
       "audio"
      ]
     },
