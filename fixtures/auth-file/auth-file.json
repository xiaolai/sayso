 {
  "id": "auth-file-torn-write",
  "component": "credentials",
  "setup": {
   "now": 1800000000,
   "marginSeconds": 600,
   "source": "file",
   "codexHome": "default",
   "file": {
    "kind": "regular",
    "raw": "{\"tokens\":{\"acc"
   },
   "retry": {
    "json": {
     "tokens": {
      "access_token": {
       "$jwt": {
        "exp": 1800003600
       }
      }
     }
    }
   }
  },
  "expect": {
   "state": "ready",
   "token": {
    "$jwt": {
     "exp": 1800003600
    }
   },
   "expiresAt": 1800003600
  },
  "note": "The first read sees a half-written file; the one re-read sees the finished file."
 },
