 {
  "id": "ws-handshake-302",
  "component": "session",
  "kind": "handshake",
  "reply": {
   "status": 302,
   "headers": {
    "x-request-id": "req_ws",
    "Location": "https://elsewhere.test/v1/realtime?k=canary_location"
   }
  },
  "expect": {
   "class": "protocol",
   "status": 302,
   "requestId": "req_ws",
   "code": "",
   "notInDescription": [
    "canary_location"
   ]
  },
  "note": "A redirect is never followed; its Location, which may carry a secret, is never quoted."
 },
 {
  "id": "ws-handshake-302-malformed",
  "component": "session",
  "kind": "handshake",
  "reply": {
   "status": 302,
   "headers": {
    "x-request-id": "req_ws",
    "Location": "/canary_malformed%zz"
   }
  },
  "expect": {
   "class": "protocol",
   "status": 302,
   "requestId": "req_ws",
   "code": "",
   "notInDescription": [
    "canary_malformed"
   ]
  },
  "note": "A malformed Location is the same refusal, never a network failure, and is not quoted."
 },
 {
  "id": "ws-handshake-101-malformed",
  "component": "session",
  "kind": "handshake",
  "reply": {
   "status": 101,
   "headers": {
    "Connection": "Upgrade",
    "Upgrade": "websocket"
   },
   "hold": true
  },
  "handshakeTimeoutMs": 300,
  "expect": {
   "class": "protocol",
   "status": 101,
   "withinMs": 2500
  },
  "note": "A 101 without Sec-WebSocket-Accept, held open: protocol, within the handshake timeout's bound."
 },
 {
  "id": "ws-handshake-silent",
  "component": "session",
  "kind": "handshake",
  "silent": true,
  "handshakeTimeoutMs": 300,
  "expect": {
   "class": "network",
   "withinMs": 2500,
   "request": {
    "target": "/v1/realtime?model=m",
    "authorization": "Bearer ek_conformance"
   }
  },
  "note": "The server reads the upgrade request and never answers: the handshake timeout ends it."
 }
]