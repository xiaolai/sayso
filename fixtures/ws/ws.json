 {
  "id": "ws-unknown-types-at-count-budget",
  "component": "session",
  "kind": "unknown-types",
  "types": 256,
  "typeBytes": 16,
  "rounds": 2,
  "expect": {
   "delivered": 512,
   "distinct": 256
  },
  "note": "256 distinct unknown types are within the accounting budget (spec/session.md); a type already counted is counted again. Type i is \"drift.<i>.\" padded with \"a\" to typeBytes bytes; the server sends every type once per round, in order, as {\"type\": <type>}."
 },
 {
  "id": "ws-unknown-types-past-count-budget",
  "component": "session",
  "kind": "unknown-types",
  "types": 257,
  "typeBytes": 16,
  "rounds": 1,
  "expect": {
   "delivered": 256,
   "distinct": 256,
   "class": "protocol"
  },
  "note": "The 257th distinct unknown type ends the session as protocol, undelivered and uncounted. Type i is \"drift.<i>.\" padded with \"a\" to typeBytes bytes; the server sends every type once per round, in order, as {\"type\": <type>}."
 },
 {
  "id": "ws-unknown-types-at-byte-budget",
  "component": "session",
  "kind": "unknown-types",
  "types": 64,
  "typeBytes": 1024,
  "rounds": 1,
  "expect": {
   "delivered": 64,
   "distinct": 64
  },
  "note": "64 distinct types of 1024 bytes are exactly the 64 KiB byte budget. Type i is \"drift.<i>.\" padded with \"a\" to typeBytes bytes; the server sends every type once per round, in order, as {\"type\": <type>}."
 },
 {
  "id": "ws-unknown-types-past-byte-budget",
  "component": "session",
  "kind": "unknown-types",
  "types": 65,
  "typeBytes": 1024,
  "rounds": 1,
  "expect": {
   "delivered": 64,
   "distinct": 64,
   "class": "protocol"
  },
  "note": "One more type past the 64 KiB byte budget ends the session as protocol. Type i is \"drift.<i>.\" padded with \"a\" to typeBytes bytes; the server sends every type once per round, in order, as {\"type\": <type>}."
 },
 {
  "id": "ws-handshake-401",
  "component": "session",
  "kind": "handshake",
  "reply": {
   "status": 401,
   "headers": {
    "x-request-id": "req_ws"
   },
   "body": "{\"error\":{\"message\":\"no\",\"type\":\"invalid_request_error\",\"code\":\"missing_scope\",\"param\":null}}"
  },
  "expect": {
   "class": "auth-expired",
   "status": 401,
   "requestId": "req_ws",
   "code": "",
   "request": {
    "target": "/v1/realtime?model=m",
    "authorization": "Bearer ek_conformance"
   }
  },
  "note": "Classified by its status alone: the body names missing_scope, which is never read."
 },
