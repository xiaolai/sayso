[
 {
  "id": "private-sign-in-written",
  "component": "credentials",
  "setup": {
   "now": 1800000000,
   "privateSignIn": {
    "token": {
     "$jwt": {
      "exp": 1800003600,
      "https://api.openai.com/auth": {
       "chatgpt_account_id": "acct-0123"
      }
     }
    },
    "folder": "private"
   }
  },
  "expect": {
   "class": "",
   "signIn": "{\"auth_mode\":\"chatgpt\",\"last_refresh\":\"2027-01-15T08:00:00Z\",\"tokens\":{\"id_token\":\"$token\",\"access_token\":\"$token\",\"refresh_token\":\"\",\"account_id\":\"acct-0123\"}}",
   "fileMode": "0600",
   "entries": {
    "auth.json": "file"
   }
  },
  "note": "The access token is also the id_token: Codex reads the account and plan from the id_token's claims, and the access token carries them. No refresh token; refreshed now."
 },
